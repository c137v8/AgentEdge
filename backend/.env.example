# Get these from Razorpay Dashboard -> Settings -> API Keys
# IMPORTANT: toggle "Test Mode" on before generating keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Optional: if set, the agent's NLU and reply-composition use Gemini.
# Get a free key from https://aistudio.google.com/apikey
# If left blank, a rule-based parser + template replies are used instead
# (still fully functional -- useful for demoing with no internet).
GEMINI_API_KEY=

# Optional override. Defaults to gemini-2.5-flash if unset. Google ships
# new Gemini versions often (2.0 was shut down June 2026) -- check
# https://ai.google.dev/gemini-api/docs/models before your demo in case
# the default here is stale by the time you read this.
GEMINI_MODEL=gemini-2.5-flash
