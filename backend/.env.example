# Get these from Razorpay Dashboard -> Settings -> API Keys
# IMPORTANT: toggle "Test Mode" on before generating keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Optional: if set, the agent's NLU uses Claude for intent parsing.
# If left blank, a rule-based parser is used instead (still fully functional).
ANTHROPIC_API_KEY=
